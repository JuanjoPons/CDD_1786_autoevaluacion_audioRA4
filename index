<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cuestionario Interactivo - RA4 Criterio Docente en la Evaluación Digital</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen py-8 px-4 flex flex-col justify-between">
    <div class="max-w-3xl mx-auto bg-white rounded-2xl shadow-xl overflow-hidden border border-slate-100 flex-grow w-full flex flex-col">
        <!-- Header -->
        <header class="bg-indigo-700 text-white p-6 sm:p-8">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold uppercase tracking-wider bg-indigo-500/40 text-indigo-100 px-3 py-1 rounded-full border border-indigo-400/30">
                    MPCDPD (1786) • RA4
                </span>
                <span id="progress-text" class="text-sm font-medium text-indigo-200">
                    Pregunta <span id="current-question-num">1</span> de 10
                </span>
            </div>
            <h1 class="text-xl sm:text-2xl font-bold mt-3">Criterio Docente en la Evaluación Digital</h1>
            <p class="text-indigo-200 text-sm mt-1">Comprueba tus conocimientos sobre la toma de decisiones y el uso crítico de la tecnología en la evaluación.</p>
            
            <!-- Progress Bar -->
            <div class="w-full bg-indigo-900/40 h-2 rounded-full mt-6 overflow-hidden">
                <div id="progress-bar" class="bg-emerald-400 h-full w-10 transition-all duration-300"></div>
            </div>
        </header>

        <!-- Quiz Container -->
        <main class="p-6 sm:p-8 flex-grow flex flex-col justify-between">
            <div id="quiz-screen">
                <div id="question-container" class="mb-6">
                    <h2 id="question-title" class="text-lg sm:text-xl font-semibold text-slate-900 mb-4">
                        <!-- Question text inserted via JS -->
                    </h2>
                    <div id="options-container" class="space-y-3">
                        <!-- Options inserted via JS -->
                    </div>
                </div>

                <!-- Feedback Message -->
                <div id="feedback-container" class="hidden p-4 rounded-xl mb-6">
                    <div class="flex items-start gap-3">
                        <i id="feedback-icon" class="text-xl mt-0.5"></i>
                        <div>
                            <h4 id="feedback-title" class="font-bold text-sm"></h4>
                            <p id="feedback-text" class="text-sm mt-1"></p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Results Screen (Initially Hidden) -->
            <div id="results-screen" class="hidden text-center py-8">
                <div class="inline-flex items-center justify-center w-24 h-24 bg-indigo-50 rounded-full text-indigo-600 mb-6 text-4xl">
                    <i class="fas me-1" id="score-icon"></i>
                </div>
                <h2 class="text-2xl font-bold text-slate-900">¡Cuestionario Completado!</h2>
                <p class="text-slate-600 mt-2">Has finalizado la comprobación de conocimientos del RA4.</p>
                
                <div class="bg-slate-50 border border-slate-200 rounded-xl p-6 my-6 max-w-sm mx-auto">
                    <span class="text-xs uppercase tracking-wider text-slate-500 font-semibold">Puntuación Final</span>
                    <div class="text-4xl font-extrabold text-indigo-600 mt-1" id="score-text">0 / 10</div>
                    <div class="text-sm font-medium mt-2" id="score-percentage">0%</div>
                </div>

                <div id="score-message" class="text-slate-700 text-sm max-w-md mx-auto mb-8"></div>

                <button id="restart-btn" class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-6 py-3 rounded-xl transition duration-200 shadow-md inline-flex items-center gap-2">
                    <i class="fas fa-rotate-right"></i> Repetir Cuestionario
                </button>
            </div>

            <!-- Controls -->
            <div id="controls" class="flex justify-between items-center border-t border-slate-100 pt-6 mt-4">
                <button id="prev-btn" class="px-4 py-2 text-slate-600 hover:text-slate-900 font-medium text-sm rounded-lg hover:bg-slate-100 transition disabled:opacity-30 disabled:pointer-events-none">
                    <i class="fas fa-chevron-left mr-2"></i> Anterior
                </button>
                <button id="next-btn" class="bg-indigo-600 hover:bg-indigo-700 text-white font-medium px-6 py-2.5 rounded-xl text-sm transition shadow-sm disabled:opacity-50 disabled:pointer-events-none">
                    Siguiente <i class="fas fa-chevron-right ml-2"></i>
                </button>
            </div>
        </main>
    </div>

    <script>
        const questions = [
            {
                question: "1. Antes de emplear tecnologías digitales en el proceso de evaluación, ¿cuál debe ser la actitud inicial del docente según los criterios analizados?",
                options: [
                    "Delegar por completo el juicio evaluativo en la herramienta tecnológica.",
                    "Mantener una reflexión crítica sobre las ventajas e inconvenientes de su uso.",
                    "Evitar cualquier tipo de análisis previo para ganar agilidad en el aula.",
                    "Utilizarlas de forma exclusiva sin compararlas con los métodos tradicionales."
                ],
                correct: 1,
                explanation: "Correcto. El docente debe analizar críticamente las ventajas e inconvenientes de las herramientas tecnológicas antes de su aplicación."
            },
            {
                question: "2. ¿Cómo deben utilizarse las tecnologías y herramientas digitales en los procesos de evaluación?",
                options: [
                    "De forma espontánea y sin planificación previa.",
                    "Únicamente cuando falle el soporte analógico o papel.",
                    "De forma sistemática e intencionada, siguiendo el protocolo de seguridad.",
                    "Exclusivamente bajo la supervisión directa del departamento de informática."
                ],
                correct: 2,
                explanation: "Correcto. Su uso debe responder a una planificación pedagógica intencionada y sistemática respetando las medidas de seguridad."
            },
            {
                question: "3. ¿Cuál de los siguientes instrumentos se asocia habitualmente con la evaluación diagnóstica en un entorno digital?",
                options: [
                    "Un cuestionario digital breve sobre conocimientos previos y experiencia.",
                    "Un portafolio digital de documentación a largo plazo.",
                    "Una prueba objetiva final de corrección automática.",
                    "Un mural digital colaborativo de cierre de trimestre."
                ],
                correct: 0,
                explanation: "Correcto. Los cuestionarios iniciales permiten sondear las ideas previas y el nivel de partida del alumnado."
            },
            {
                question: "4. ¿Qué ventaja principal presenta el uso de herramientas digitales en la evaluación frente al soporte tradicional?",
                options: [
                    "La eliminación total de cualquier margen de error humano.",
                    "La rapidez en el proceso y una mayor trazabilidad de las evidencias.",
                    "La completa independencia de la red eléctrica o de internet.",
                    "La supresión de la necesidad de aplicar protocolos de seguridad."
                ],
                correct: 1,
                explanation: "Correcto. Agiliza los tiempos de gestión/corrección y facilita el seguimiento continuo del histórico de aprendizaje."
            },
            {
                question: "5. En relación con el uso de herramientas de Inteligencia Artificial (IA) para analizar datos evaluativos, el docente debe:",
                options: [
                    "Aceptar de forma automática e indiscutible todas las conclusiones generadas.",
                    "Delegar en la máquina la toma de decisiones finales sobre el alumno.",
                    "Contratar servicios externos para auditar el software constantemente.",
                    "Contrastar los resultados obtenidos con su propio criterio pedagógico."
                ],
                correct: 3,
                explanation: "Correcto. La IA puede detectar patrones, pero la interpretación y decisión evaluativa final recaen en el criterio pedagógico docente."
            },
            {
                question: "6. ¿Qué finalidad principal persiguen los sistemas digitales de planificación, registro y consulta del aprendizaje para el alumnado?",
                options: [
                    "Sustituir por completo la labor de tutoría y orientación presencial del profesor.",
                    "Permitir que el alumno mantenga una visión organizada y actualizada de su propio progreso.",
                    "Ocultar las calificaciones obtenidas hasta el final de la acción formativa.",
                    "Evitar que el estudiante reflexione sobre sus propias dificultades de aprendizaje."
                ],
                correct: 1,
                explanation: "Correcto. Favorecen la autorregulación y la reflexión del propio alumnado sobre su proceso de aprendizaje."
            },
            {
                question: "7. Cuando el docente utiliza tecnologías digitales para ofrecer retroalimentación (feedback) al alumnado, debe garantizar fundamentalmente:",
                options: [
                    "Que la información sea pública para todo el grupo clase.",
                    "El respeto a la privacidad de la información facilitada.",
                    "Que el mensaje se envíe exclusivamente a través de redes sociales abiertas.",
                    "Que la respuesta sea siempre automatizada sin intervención personal."
                ],
                correct: 1,
                explanation: "Correcto. Es indispensable garantizar la confidencialidad y protección de datos individuales en los canales digitales."
            },
            {
                question: "8. ¿Cómo debe proyectarse la competencia digital del docente en lo que respecta a su propia práctica profesional?",
                options: [
                    "Evaluando de forma autónoma la calidad de la propia acción formativa para proponer mejoras.",
                    "Limitándose a cumplir con los expedientes administrativos exigidos por el centro.",
                    "Evitando revisar las grabaciones o datos de participación en los entornos virtuales.",
                    "Considerando que la práctica docente no es susceptible de mejora digital."
                ],
                correct: 0,
                explanation: "Correcto. La autoevaluación reflexiva sobre la propia docencia permite fundamentar propuestas de mejora continua."
            },
            {
                question: "9. ¿Qué se busca al integrar herramientas como murales o portafolios digitales dentro de la evaluación formativa?",
                options: [
                    "Automatizar la calificación final sin tener en cuenta el proceso de aprendizaje.",
                    "Visualizar de forma colaborativa las aportaciones y documentar el progreso del alumnado.",
                    "Reducir drásticamente las horas de dedicación del profesor a la tutoría.",
                    "Sancionar los errores cometidos en las primeras fases del trabajo grupal."
                ],
                correct: 1,
                explanation: "Correcto. Permiten recoger evidencias continuadas del aprendizaje y visibilizar el trabajo colaborativo en tiempo real."
            },
            {
                question: "10. ¿Qué riesgo principal conlleva una mala integración de las tecnologías digitales en los procesos evaluativos?",
                options: [
                    "La mejora automática e inmediata de las competencias transversales del grupo.",
                    "La dependencia excesiva de la conexión y posibles riesgos de despersonalización o brechas.",
                    "La obligatoriedad de eliminar las pruebas de carácter práctico en los talleres.",
                    "La prohibición legal de utilizar contenidos multimedia en el aula."
                ],
                correct: 1,
                explanation: "Correcto. Una mala planificación puede acentuar brechas preexistentes o despersonalizar el seguimiento del estudiante."
            }
        ];

        let currentQuestion = 0;
        let userAnswers = new Array(questions.length).fill(null);

        // Elements
        const questionTitle = document.getElementById('question-title');
        const optionsContainer = document.getElementById('options-container');
        const feedbackContainer = document.getElementById('feedback-container');
        const feedbackIcon = document.getElementById('feedback-icon');
        const feedbackTitle = document.getElementById('feedback-title');
        const feedbackText = document.getElementById('feedback-text');
        const prevBtn = document.getElementById('prev-btn');
        const nextBtn = document.getElementById('next-btn');
        const progressBar = document.getElementById('progress-bar');
        const currentQuestionNum = document.getElementById('current-question-num');
        const quizScreen = document.getElementById('quiz-screen');
        const resultsScreen = document.getElementById('results-screen');
        const controls = document.getElementById('controls');
        const progressText = document.getElementById('progress-text');
        const restartBtn = document.getElementById('restart-btn');

        function loadQuestion() {
            const q = questions[currentQuestion];
            questionTitle.textContent = q.question;
            optionsContainer.innerHTML = '';
            
            // Hide feedback when loading new state unless already answered
            feedbackContainer.classList.add('hidden');

            q.options.forEach((opt, idx) => {
                const btn = document.createElement('button');
                btn.className = `w-full text-left p-4 rounded-xl border text-sm font-medium transition duration-200 flex items-center justify-between gap-3 ${
                    userAnswers[currentQuestion] === idx 
                        ? 'border-indigo-600 bg-indigo-50/50 text-indigo-900 shadow-sm' 
                        : 'border-slate-200 hover:border-slate-300 hover:bg-slate-50 text-slate-700'
                }`;

                btn.innerHTML = `
                    <span class="flex-grow">${opt}</span>
                    <span class="w-5 h-5 rounded-full border flex items-center justify-center shrink-0 ${
                        userAnswers[currentQuestion] === idx ? 'border-indigo-600 bg-indigo-600 text-white' : 'border-slate-300'
                    }">
                        ${userAnswers[currentQuestion] === idx ? '<i class="fas fa-check text-xs"></i>' : ''}
                    </span>
                `;

                btn.addEventListener('click', () => selectOption(idx));
                optionsContainer.appendChild(btn);
            });

            // Update Header & Progress
            currentQuestionNum.textContent = currentQuestion + 1;
            const progress = ((currentQuestion + 1) / questions.length) * 100;
            progressBar.style.width = `${progress}%`;

            // Update Controls
            prevBtn.disabled = currentQuestion === 0;
            nextBtn.textContent = currentQuestion === questions.length - 1 ? 'Ver Resultados' : 'Siguiente';
            
            // If already answered, show feedback
            if (userAnswers[currentQuestion] !== null) {
                showFeedback(userAnswers[currentQuestion]);
            }
        }

        function selectOption(index) {
            userAnswers[currentQuestion] = index;
            loadQuestion();
            showFeedback(index);
        }

        function showFeedback(selectedIndex) {
            const q = questions[currentQuestion];
            const isCorrect = selectedIndex === q.correct;

            feedbackContainer.className = `p-4 rounded-xl mb-6 flex items-start gap-3 ${
                isCorrect ? 'bg-emerald-50 text-emerald-900 border border-emerald-200' : 'bg-amber-50 text-amber-900 border border-amber-200'
            }`;

            feedbackIcon.className = `fas ${isCorrect ? 'fa-circle-check text-emerald-600' : 'fa-circle-exclamation text-amber-600'} text-xl mt-0.5`;
            feedbackTitle.textContent = isCorrect ? '¡Respuesta Correcta!' : 'Respuesta Incorrecta';
            feedbackText.textContent = isCorrect ? q.explanation : `La respuesta correcta era: "${q.options[q.correct]}". ${q.explanation}`;
            
            feedbackContainer.classList.remove('hidden');
        }

        function showResults() {
            quizScreen.classList.add('hidden');
            controls.classList.add('hidden');
            progressText.classList.add('hidden');
            resultsScreen.classList.remove('hidden');

            let score = 0;
            userAnswers.forEach((ans, idx) => {
                if (ans === questions[idx].correct) score++;
            });

            const percentage = Math.round((score / questions.length) * 100);
            
            document.getElementById('score-text').textContent = `${score} / ${questions.length}`;
            document.getElementById('score-percentage').textContent = `${percentage}% de aciertos`;

            const scoreIcon = document.getElementById('score-icon');
            const scoreMessage = document.getElementById('score-message');

            if (percentage >= 80) {
                scoreIcon.className = "fas fa-trophy text-amber-500";
                scoreMessage.textContent = "¡Excelente trabajo! Has demostrado una comprensión profunda sobre los criterios pedagógicos en la evaluación digital.";
            } else if (percentage >= 50) {
                scoreIcon.className = "fas fa-medal text-indigo-500";
                scoreMessage.textContent = "¡Buen esfuerzo! Has superado el test, aunque conviene repasar algunos conceptos clave de la unidad.";
            } else {
                scoreIcon.className = "fas fa-book-open text-rose-500";
                scoreMessage.textContent = "Te recomendamos volver a escuchar el audio o revisar el manual del RA4 para afianzar los conceptos pedagógicos evaluativos.";
            }
        }

        // Event Listeners
        prevBtn.addEventListener('click', () => {
            if (currentQuestion > 0) {
                currentQuestion--;
                loadQuestion();
            }
        });

        nextBtn.addEventListener('click', () => {
            if (userAnswers[currentQuestion] === null) {
                alert('Por favor, selecciona una respuesta antes de continuar.');
                return;
            }
            
            if (currentQuestion < questions.length - 1) {
                currentQuestion++;
                loadQuestion();
            } else {
                showResults();
            }
        });

        restartBtn.addEventListener('click', () => {
            currentQuestion = 0;
            userAnswers = new Array(questions.length).fill(null);
            quizScreen.classList.remove('hidden');
            controls.classList.remove('hidden');
            progressText.classList.remove('hidden');
            resultsScreen.classList.add('hidden');
            loadQuestion();
        });

        // Initialize
        loadQuestion();
    </script>
</body>
</html>
```eof

I have generated the interactive, self-correcting HTML questionnaire for **RA4 (Criterio docente en la evaluación digital)**. 

### Summary of Features:
* **Interactive & Self-Correcting:** Gives immediate feedback after answering each question with explanations.
* **Progress Tracking:** Includes a real-time progress bar and score screen upon completion.
* **Responsive Design:** Styled cleanly using Tailwind CSS for desktop and mobile viewports.
