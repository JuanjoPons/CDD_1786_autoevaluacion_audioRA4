<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RA4 - Criterio Docente en la Evaluación Digital</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
        .slide {
            display: none;
            opacity: 0;
            transition: opacity 0.3s ease-in-out;
        }
        .slide.active {
            display: flex;
            opacity: 1;
        }
        /* Custom scrollbar for container elements */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(15, 23, 42, 0.6);
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(99, 102, 241, 0.5);
            border-radius: 3px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(99, 102, 241, 0.8);
        }
    </style>
</head>
<body class="bg-slate-900 text-slate-100 h-full flex flex-col justify-between font-sans antialiased select-none overflow-x-hidden">

    <!-- Modal para mensajes/alertas (reemplazo de alert por guías) -->
    <div id="custom-modal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center hidden">
        <div class="bg-slate-800 border border-slate-700 rounded-xl p-6 max-w-sm w-full mx-4 shadow-2xl text-center space-y-4">
            <div class="w-12 h-12 bg-amber-500/20 text-amber-400 rounded-full flex items-center justify-center mx-auto text-xl">
                <i class="fas fa-exclamation-triangle"></i>
            </div>
            <h3 class="text-lg font-bold text-white">Atención</h3>
            <p id="modal-message" class="text-xs text-slate-300 leading-relaxed"></p>
            <button onclick="closeModal()" class="bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold px-4 py-2 rounded-lg transition w-full">
                Entendido
            </button>
        </div>
    </div>

    <!-- Header / Barra de Navegación Superior -->
    <header class="w-full bg-slate-950/80 border-b border-slate-800 px-4 sm:px-6 py-3.5 flex justify-between items-center z-10 backdrop-blur-md shrink-0">
        <div class="flex items-center space-x-3">
            <span class="bg-indigo-600 text-white text-[10px] sm:text-xs px-2.5 py-1 rounded-full font-bold uppercase tracking-wider">MPCDPD (1786)</span>
            <h1 class="text-xs sm:text-sm font-semibold text-slate-300 hidden sm:block truncate max-w-md">RA4 · Criterio Docente en la Evaluación Digital</h1>
        </div>
        <div class="text-xs font-mono text-slate-400 bg-slate-900 px-3 py-1 rounded-lg border border-slate-800">
            Diapositiva <span id="current-slide-num" class="text-indigo-400 font-bold">1</span> / <span id="total-slides-num">6</span>
        </div>
    </header>

    <!-- ÁREA PRINCIPAL DE CONTENIDO -->
    <main class="flex-grow flex items-center justify-center p-4 sm:p-6 md:p-8 relative overflow-y-auto">

        <!-- Diapositiva 1: Portada -->
        <section class="slide active flex-col items-center justify-center text-center max-w-4xl mx-auto space-y-6 my-auto">
            <div class="inline-flex p-4 bg-indigo-900/40 rounded-full border border-indigo-500/30 text-indigo-400 mb-2 shadow-lg shadow-indigo-950/50">
                <i class="fas fa-clipboard-check text-4xl sm:text-5xl"></i>
            </div>
            <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight">
                Criterio Docente en la <br class="hidden sm:inline"/><span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-cyan-400">Evaluación Digital</span>
            </h2>
            <p class="text-sm sm:text-base text-slate-300 max-w-2xl leading-relaxed">
                Estrategias, analítica de datos, retroalimentación pedagógica y principios de evaluación diagnóstica, formativa y sumativa en entornos de Formación Profesional.
            </p>
            <div class="flex flex-wrap justify-center gap-2.5 pt-4">
                <span class="bg-slate-800/80 border border-slate-700/80 text-slate-300 px-3 py-1.5 rounded-lg text-xs font-medium"><i class="fas fa-chart-line text-indigo-400 mr-1.5"></i>Analítica & IA</span>
                <span class="bg-slate-800/80 border border-slate-700/80 text-slate-300 px-3 py-1.5 rounded-lg text-xs font-medium"><i class="fas fa-comments text-cyan-400 mr-1.5"></i>Feedback Oportuno</span>
                <span class="bg-slate-800/80 border border-slate-700/80 text-slate-300 px-3 py-1.5 rounded-lg text-xs font-medium"><i class="fas fa-shield-halved text-emerald-400 mr-1.5"></i>Seguridad & Privacidad</span>
            </div>
        </section>

        <!-- Diapositiva 2: Funciones e Instrumentos -->
        <section class="slide flex-col justify-center max-w-5xl mx-auto w-full space-y-6 my-auto">
            <div class="border-l-4 border-indigo-500 pl-4">
                <span class="text-xs text-indigo-400 font-bold uppercase tracking-wider">Bloque 1</span>
                <h2 class="text-xl sm:text-3xl font-bold text-white">Instrumentos Digitales según la Finalidad</h2>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="bg-slate-800/60 border border-slate-700/60 rounded-xl p-5 hover:border-indigo-500/50 transition">
                    <div class="w-10 h-10 rounded-lg bg-indigo-500/20 text-indigo-400 flex items-center justify-center mb-4 text-xl">
                        <i class="fas fa-magnifying-glass"></i>
                    </div>
                    <h3 class="font-bold text-base sm:text-lg text-white mb-2">Diagnóstica</h3>
                    <p class="text-xs text-slate-400 leading-relaxed">Sondeo inicial de conocimientos previos y nivel competencial. Cuestionarios digitales breves y pruebas objetivas de entrada.</p>
                </div>
                <div class="bg-slate-800/60 border border-slate-700/60 rounded-xl p-5 hover:border-indigo-500/50 transition">
                    <div class="w-10 h-10 rounded-lg bg-cyan-500/20 text-cyan-400 flex items-center justify-center mb-4 text-xl">
                        <i class="fas fa-arrows-spin"></i>
                    </div>
                    <h3 class="font-bold text-base sm:text-lg text-white mb-2">Formativa</h3>
                    <p class="text-xs text-slate-400 leading-relaxed">Seguimiento continuo del proceso de aprendizaje. Portafolios digitales, murales colaborativos (Padlet) y rúbricas (CoRubrics).</p>
                </div>
                <div class="bg-slate-800/60 border border-slate-700/60 rounded-xl p-5 hover:border-indigo-500/50 transition">
                    <div class="w-10 h-10 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center mb-4 text-xl">
                        <i class="fas fa-award"></i>
                    </div>
                    <h3 class="font-bold text-base sm:text-lg text-white mb-2">Sumativa</h3>
                    <p class="text-xs text-slate-400 leading-relaxed">Verificación del logro final de resultados de aprendizaje. Pruebas automatizadas de corrección e informes globales de desempeño.</p>
                </div>
            </div>
        </section>

        <!-- Diapositiva 3: Analítica de Datos e IA -->
        <section class="slide flex-col justify-center max-w-5xl mx-auto w-full space-y-6 my-auto">
            <div class="border-l-4 border-cyan-500 pl-4">
                <span class="text-xs text-cyan-400 font-bold uppercase tracking-wider">Bloque 2</span>
                <h2 class="text-xl sm:text-3xl font-bold text-white">Analítica de Datos e Inteligencia Artificial</h2>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="bg-slate-800/50 border border-slate-700/60 rounded-xl p-6 space-y-3">
                    <div class="flex items-center space-x-3 text-cyan-400 mb-2">
                        <i class="fas fa-brain text-2xl"></i>
                        <h3 class="font-bold text-base text-white">Rol de la IA y Tratamiento de Datos</h3>
                    </div>
                    <ul class="space-y-2.5 text-xs text-slate-300">
                        <li class="flex items-start"><i class="fas fa-check-circle text-cyan-500 mr-2.5 mt-0.5 shrink-0"></i>Identificación temprana de patrones de dificultad en el grupo.</li>
                        <li class="flex items-start"><i class="fas fa-check-circle text-cyan-500 mr-2.5 mt-0.5 shrink-0"></i>Trazabilidad y registro continuo del avance individual y colaborativo.</li>
                        <li class="flex items-start"><i class="fas fa-check-circle text-cyan-500 mr-2.5 mt-0.5 shrink-0"></i>Optimización de la planificación docente mediante evidencias de aprendizaje.</li>
                    </ul>
                </div>
                <div class="bg-indigo-950/40 border border-indigo-500/30 rounded-xl p-6 space-y-3 flex flex-col justify-center">
                    <div class="flex items-center space-x-3 text-indigo-400 mb-2">
                        <i class="fas fa-user-shield text-2xl"></i>
                        <h3 class="font-bold text-base text-white">Criterio Humano Irremplazable</h3>
                    </div>
                    <p class="text-xs text-slate-300 leading-relaxed">
                        Las herramientas de IA sugieren patrones y procesan datos, pero la toma de decisiones evaluativas, el acompañamiento emocional y el juicio pedagógico final corresponden <strong class="text-indigo-300">siempre al docente</strong>.
                    </p>
                </div>
            </div>
        </section>

        <!-- Diapositiva 4: Retroalimentación y Seguridad -->
        <section class="slide flex-col justify-center max-w-5xl mx-auto w-full space-y-6 my-auto">
            <div class="border-l-4 border-emerald-500 pl-4">
                <span class="text-xs text-emerald-400 font-bold uppercase tracking-wider">Bloque 3</span>
                <h2 class="text-xl sm:text-3xl font-bold text-white">Retroalimentación Eficaz & Protección de Datos</h2>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="bg-slate-800/50 border border-slate-700/60 rounded-xl p-6">
                    <h3 class="font-bold text-white mb-3 text-sm flex items-center"><i class="fas fa-comment-dots text-emerald-400 mr-2"></i>Principios de un Feedback Eficaz</h3>
                    <div class="space-y-2 text-xs text-slate-300">
                        <p class="bg-slate-900/60 p-2.5 rounded-lg border border-slate-700/40"><strong class="text-emerald-400">Oportuno:</strong> Entregado en plazos útiles para permitir la corrección activa.</p>
                        <p class="bg-slate-900/60 p-2.5 rounded-lg border border-slate-700/40"><strong class="text-emerald-400">Específico:</strong> Orientado a la mejora concreta, evitando comentarios genéricos.</p>
                        <p class="bg-slate-900/60 p-2.5 rounded-lg border border-slate-700/40"><strong class="text-emerald-400">Constructivo:</strong> Centrado en el progreso competencial del estudiante.</p>
                    </div>
                </div>
                <div class="bg-slate-800/50 border border-slate-700/60 rounded-xl p-6">
                    <h3 class="font-bold text-white mb-3 text-sm flex items-center"><i class="fas fa-lock text-amber-400 mr-2"></i>Seguridad y Privacidad (LOPDGDD/RGPD)</h3>
                    <div class="space-y-2 text-xs text-slate-300">
                        <p class="bg-slate-900/60 p-2.5 rounded-lg border border-slate-700/40"><strong class="text-amber-400">Confidencialidad:</strong> Canalización privada de calificaciones y retroalimentaciones.</p>
                        <p class="bg-slate-900/60 p-2.5 rounded-lg border border-slate-700/40"><strong class="text-amber-400">Entornos Seguros:</strong> Uso exclusivo de las plataformas corporativas e institucionales del centro.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Diapositiva 5: Test de Autoevaluación -->
        <section class="slide flex-col justify-center max-w-4xl mx-auto w-full space-y-4 my-auto">
            <div class="text-center mb-1">
                <span class="text-xs text-indigo-400 font-bold uppercase tracking-wider">Comprobación de Lectura</span>
                <h2 class="text-lg sm:text-2xl font-bold text-white">Test de Autoevaluación RA4</h2>
            </div>
            
            <div class="bg-slate-800/80 border border-slate-700 rounded-2xl p-5 sm:p-6 shadow-2xl relative min-h-[380px] flex flex-col justify-between">
                <!-- Quiz Header -->
                <div class="flex justify-between items-center border-b border-slate-700/60 pb-3">
                    <span id="quiz-question-num" class="text-xs font-semibold text-indigo-400 uppercase tracking-wider">Pregunta 1 de 10</span>
                    <span id="quiz-score-live" class="text-xs font-mono text-slate-400 bg-slate-900 px-2.5 py-1 rounded border border-slate-700">Aciertos: 0</span>
                </div>

                <!-- Quiz Body -->
                <div id="quiz-question-container" class="my-3">
                    <h3 id="quiz-question-title" class="text-xs sm:text-sm md:text-base font-medium text-slate-100 mb-3 leading-relaxed">
                        <!-- Cargado dinámicamente -->
                    </h3>
                    <div id="quiz-options-container" class="space-y-2">
                        <!-- Cargado dinámicamente -->
                    </div>
                </div>

                <!-- Feedback Display -->
                <div id="quiz-feedback" class="hidden p-3 rounded-lg text-xs leading-relaxed border mb-3"></div>

                <!-- Controles de navegación del test -->
                <div class="flex justify-between items-center border-t border-slate-700/60 pt-3">
                    <button id="quiz-prev-btn" class="px-3 py-1.5 text-xs text-slate-400 hover:text-white disabled:opacity-30 disabled:pointer-events-none flex items-center transition">
                        <i class="fas fa-chevron-left mr-1"></i> Anterior
                    </button>
                    <button id="quiz-next-btn" class="bg-indigo-600 hover:bg-indigo-500 text-white font-medium px-4 py-1.5 rounded-lg text-xs transition disabled:opacity-40 disabled:pointer-events-none flex items-center">
                        Siguiente <i class="fas fa-chevron-right ml-1"></i>
                    </button>
                </div>
            </div>
        </section>

        <!-- Diapositiva 6: Conclusión -->
        <section class="slide flex-col items-center justify-center text-center max-w-4xl mx-auto space-y-6 my-auto">
            <div class="w-16 h-16 bg-emerald-500/20 text-emerald-400 rounded-full flex items-center justify-center text-3xl mb-2 border border-emerald-500/30">
                <i class="fas fa-flag-checkered"></i>
            </div>
            <h2 class="text-2xl sm:text-4xl font-extrabold text-white">¡Resumen RA4 Completado!</h2>
            <p class="text-xs sm:text-base text-slate-300 max-w-xl leading-relaxed">
                El criterio docente es el eje articulador de la evaluación digital: la tecnología potencia la trazabilidad y agiliza la gestión, pero la intencionalidad pedagógica y la inclusión rigen cada decisión.
            </p>
            <button onclick="goToSlide(0)" class="bg-indigo-600 hover:bg-indigo-500 text-white text-xs sm:text-sm font-semibold px-6 py-2.5 rounded-xl transition inline-flex items-center gap-2 shadow-lg shadow-indigo-900/30">
                <i class="fas fa-rotate-left"></i> Volver al Inicio
            </button>
        </section>

    </main>

    <!-- Footer de Controles Inferiores -->
    <footer class="w-full bg-slate-950/80 border-t border-slate-800 px-4 sm:px-6 py-3.5 flex justify-between items-center z-10 shrink-0">
        <button id="prev-slide-btn" onclick="prevSlide()" class="bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs px-3.5 py-2 rounded-lg font-medium transition disabled:opacity-40 flex items-center">
            <i class="fas fa-arrow-left mr-1.5"></i> Anterior
        </button>
        
        <div class="flex space-x-1.5" id="dots-container">
            <!-- Puntos de navegación poblados dinámicamente -->
        </div>

        <button id="next-slide-btn" onclick="nextSlide()" class="bg-indigo-600 hover:bg-indigo-500 text-white text-xs px-3.5 py-2 rounded-lg font-medium transition disabled:opacity-40 flex items-center">
            Siguiente <i class="fas fa-arrow-right ml-1.5"></i>
        </button>
    </footer>

    <script>
        // Modal personalizado para reemplazar alert()
        function showAlert(msg) {
            document.getElementById('modal-message').textContent = msg;
            document.getElementById('custom-modal').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('custom-modal').classList.add('hidden');
        }

        // Lógica de Navegación por Diapositivas
        const slides = document.querySelectorAll('.slide');
        const totalSlides = slides.length;
        let currentSlide = 0;

        const currentSlideNumEl = document.getElementById('current-slide-num');
        const totalSlidesNumEl = document.getElementById('total-slides-num');
        const prevSlideBtn = document.getElementById('prev-slide-btn');
        const nextSlideBtn = document.getElementById('next-slide-btn');
        const dotsContainer = document.getElementById('dots-container');

        totalSlidesNumEl.textContent = totalSlides;

        // Renderizar puntos (dots)
        slides.forEach((_, idx) => {
            const dot = document.createElement('button');
            dot.className = `h-2 rounded-full transition-all ${idx === 0 ? 'bg-indigo-500 w-5' : 'bg-slate-700 hover:bg-slate-500 w-2'}`;
            dot.setAttribute('aria-label', `Ir a diapositiva ${idx + 1}`);
            dot.addEventListener('click', () => goToSlide(idx));
            dotsContainer.appendChild(dot);
        });

        function updateSlideUI() {
            slides.forEach((slide, idx) => {
                if (idx === currentSlide) {
                    slide.classList.add('active');
                } else {
                    slide.classList.remove('active');
                }
            });

            currentSlideNumEl.textContent = currentSlide + 1;
            prevSlideBtn.disabled = currentSlide === 0;
            nextSlideBtn.disabled = currentSlide === totalSlides - 1;

            // Actualizar estado visual de los puntos
            Array.from(dotsContainer.children).forEach((dot, idx) => {
                if (idx === currentSlide) {
                    dot.className = 'w-5 h-2 rounded-full bg-indigo-500 transition-all';
                } else {
                    dot.className = 'w-2 h-2 rounded-full bg-slate-700 hover:bg-slate-500 transition-all';
                }
            });
        }

        function nextSlide() {
            if (currentSlide < totalSlides - 1) {
                currentSlide++;
                updateSlideUI();
            }
        }

        function prevSlide() {
            if (currentSlide > 0) {
                currentSlide--;
                updateSlideUI();
            }
        }

        function goToSlide(index) {
            currentSlide = index;
            updateSlideUI();
        }

        // Teclas de dirección para la presentación
        document.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowRight' || e.key === 'Space') {
                if (currentSlide < totalSlides - 1) nextSlide();
            } else if (e.key === 'ArrowLeft') {
                if (currentSlide > 0) prevSlide();
            }
        });

        // Preguntas del Test de Autoevaluación
        const quizQuestions = [
            {
                question: "1. Antes de emplear tecnologías digitales en el proceso de evaluación, ¿cuál debe ser la actitud inicial del docente?",
                options: [
                    "Delegar por completo el juicio evaluativo en la herramienta.",
                    "Mantener una reflexión crítica sobre sus ventajas e inconvenientes.",
                    "Evitar cualquier tipo de análisis previo para ganar agilidad.",
                    "Utilizarlas de forma exclusiva sin compararlas con métodos tradicionales."
                ],
                correct: 1,
                explanation: "El docente debe analizar críticamente las ventajas e inconvenientes de las herramientas antes de su aplicación."
            },
            {
                question: "2. ¿Cómo deben utilizarse las herramientas digitales en los procesos evaluativos?",
                options: [
                    "De forma espontánea y sin planificación previa.",
                    "Únicamente cuando falle el soporte analógico.",
                    "De forma sistemática e intencionada, siguiendo protocolos de seguridad.",
                    "Exclusivamente bajo la supervisión directa del área de informática."
                ],
                correct: 2,
                explanation: "Su uso debe responder a una planificación pedagógica intencionada y respetando la seguridad."
            },
            {
                question: "3. ¿Qué instrumento se asocia a la evaluación diagnóstica en un entorno digital?",
                options: [
                    "Un cuestionario digital breve sobre conocimientos previos.",
                    "Un portafolio digital a largo plazo.",
                    "Una prueba objetiva final sumativa.",
                    "Un mural digital de cierre trimestral."
                ],
                correct: 0,
                explanation: "Los cuestionarios iniciales permiten verificar el punto de partida y los conocimientos previos."
            },
            {
                question: "4. ¿Qué ventaja principal presenta el uso de herramientas digitales en la evaluación?",
                options: [
                    "La eliminación total del margen de error humano.",
                    "La rapidez en el proceso y una mayor trazabilidad de las evidencias.",
                    "La independencia de la red eléctrica o internet.",
                    "La supresión de la necesidad de aplicar protocolos de seguridad."
                ],
                correct: 1,
                explanation: "Agiliza los tiempos de gestión y facilita el seguimiento del historial de evidencias de aprendizaje."
            },
            {
                question: "5. Al usar herramientas de Inteligencia Artificial para analizar datos evaluativos, el docente debe:",
                options: [
                    "Aceptar automáticamente todas las conclusiones generadas.",
                    "Delegar en la máquina la toma de decisiones sobre el alumno.",
                    "Contratar servicios externos para auditar el software.",
                    "Contrastar los resultados obtenidos con su propio criterio pedagógico."
                ],
                correct: 3,
                explanation: "La interpretación y decisión evaluativa recaen exclusivamente en el criterio pedagógico docente."
            },
            {
                question: "6. ¿Qué finalidad persiguen los sistemas digitales de registro y consulta del aprendizaje?",
                options: [
                    "Sustituir por completo la labor de tutoría del profesor.",
                    "Permitir que el alumno mantenga una visión actualizada de su propio progreso.",
                    "Ocultar las calificaciones hasta el final del trimestre.",
                    "Evitar que el estudiante reflexione sobre sus dificultades."
                ],
                correct: 1,
                explanation: "Favorecen la autorregulación y la reflexión del estudiante sobre su proceso."
            },
            {
                question: "7. Al ofrecer retroalimentación (feedback) digital al alumnado, se debe garantizar fundamentalmente:",
                options: [
                    "Que la información sea pública para todo el grupo.",
                    "El respeto a la privacidad de la información facilitada.",
                    "Que el mensaje se envíe solo por redes sociales abiertas.",
                    "Que la respuesta sea siempre automatizada sin intervención personal."
                ],
                correct: 1,
                explanation: "Es indispensable garantizar la confidencialidad y protección de datos en los canales digitales."
            },
            {
                question: "8. ¿Cómo debe proyectarse la competencia digital del docente sobre su propia práctica?",
                options: [
                    "Evaluando de forma autónoma la calidad de la formación para proponer mejoras.",
                    "Limitándose a cumplir con exigencias administrativas.",
                    "Evitando revisar datos de participación en entornos virtuales.",
                    "Considerando que la práctica docente no es susceptible de mejora digital."
                ],
                correct: 0,
                explanation: "La autoevaluación reflexiva permite fundamentar propuestas de mejora continua."
            },
            {
                question: "9. ¿Qué se busca al integrar murales o portafolios digitales en la evaluación formativa?",
                options: [
                    "Automatizar la calificación final sin considerar el proceso.",
                    "Visualizar de forma colaborativa aportaciones y documentar el progreso.",
                    "Reducir drásticamente las horas de tutoría presencial.",
                    "Sancionar los errores cometidos en fases iniciales."
                ],
                correct: 1,
                explanation: "Permite recopilar evidencias continuas y visibilizar el trabajo en equipo."
            },
            {
                question: "10. ¿Qué riesgo conlleva una mala integración de tecnologías en la evaluación?",
                options: [
                    "La mejora automática de las competencias transversales.",
                    "Dependencia de conexión y riesgos de despersonalización o brechas.",
                    "La obligatoriedad de eliminar pruebas prácticas.",
                    "La prohibición de usar contenidos multimedia."
                ],
                correct: 1,
                explanation: "Una mala planificación puede acentuar la brecha digital o despersonalizar el seguimiento."
            }
        ];

        let quizCurrentIndex = 0;
        let quizAnswers = new Array(quizQuestions.length).fill(null);

        const qTitleEl = document.getElementById('quiz-question-title');
        const qOptionsEl = document.getElementById('quiz-options-container');
        const qNumEl = document.getElementById('quiz-question-num');
        const qScoreEl = document.getElementById('quiz-score-live');
        const qFeedbackEl = document.getElementById('quiz-feedback');
        const qPrevBtn = document.getElementById('quiz-prev-btn');
        const qNextBtn = document.getElementById('quiz-next-btn');

        function loadQuizQuestion() {
            const q = quizQuestions[quizCurrentIndex];
            qTitleEl.textContent = q.question;
            qOptionsEl.innerHTML = '';
            qFeedbackEl.classList.add('hidden');

            q.options.forEach((opt, idx) => {
                const btn = document.createElement('button');
                const isSelected = quizAnswers[quizCurrentIndex] === idx;
                
                btn.className = `w-full text-left p-2.5 sm:p-3 rounded-lg text-xs font-medium border transition flex justify-between items-center ${
                    isSelected 
                        ? 'border-indigo-500 bg-indigo-950/60 text-white shadow-sm' 
                        : 'border-slate-700/70 hover:border-slate-600 bg-slate-900/40 text-slate-300'
                }`;

                btn.innerHTML = `
                    <span class="pr-2 leading-relaxed">${opt}</span>
                    <span class="w-4 h-4 rounded-full border border-slate-600 flex items-center justify-center shrink-0 ${isSelected ? 'bg-indigo-600 border-indigo-600 text-white' : ''}">
                        ${isSelected ? '<i class="fas fa-check text-[9px]"></i>' : ''}
                    </span>
                `;

                btn.addEventListener('click', () => {
                    quizAnswers[quizCurrentIndex] = idx;
                    loadQuizQuestion();
                    updateScoreLive();
                });

                qOptionsEl.appendChild(btn);
            });

            qNumEl.textContent = `Pregunta ${quizCurrentIndex + 1} de ${quizQuestions.length}`;
            qPrevBtn.disabled = quizCurrentIndex === 0;
            qNextBtn.textContent = quizCurrentIndex === quizQuestions.length - 1 ? 'Finalizar' : 'Siguiente';

            if (quizAnswers[quizCurrentIndex] !== null) {
                const isCorrect = quizAnswers[quizCurrentIndex] === q.correct;
                qFeedbackEl.className = `p-3 rounded-lg text-xs leading-relaxed border mb-3 ${
                    isCorrect ? 'bg-emerald-950/50 border-emerald-500/40 text-emerald-200' : 'bg-amber-950/50 border-amber-500/40 text-amber-200'
                }`;
                qFeedbackEl.innerHTML = `<strong>${isCorrect ? '¡Correcto!' : 'Respuesta incorrecta.'}</strong> ${q.explanation}`;
                qFeedbackEl.classList.remove('hidden');
            }
        }

        function updateScoreLive() {
            let correctCount = 0;
            quizAnswers.forEach((ans, idx) => {
                if (ans === quizQuestions[idx].correct) correctCount++;
            });
            qScoreEl.textContent = `Aciertos: ${correctCount}`;
        }

        qPrevBtn.addEventListener('click', () => {
            if (quizCurrentIndex > 0) {
                quizCurrentIndex--;
                loadQuizQuestion();
            }
        });

        qNextBtn.addEventListener('click', () => {
            if (quizAnswers[quizCurrentIndex] === null) {
                showAlert('Por favor, selecciona una respuesta antes de continuar.');
                return;
            }
            if (quizCurrentIndex < quizQuestions.length - 1) {
                quizCurrentIndex++;
                loadQuizQuestion();
            } else {
                goToSlide(5); // Avanzar a la diapositiva de conclusión
            }
        });

        // Inicialización al cargar la ventana
        window.onload = function () {
            loadQuizQuestion();
            updateSlideUI();
        };
    </script>
</body>
</html>
